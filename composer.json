{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "aws/aws-sdk-php": "^3.368",
        "ext-ctype": "*",
        "ext-date": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pcre": "*",
        "ext-pdo_mysql": "*",
        "ext-phar": "*",
        "ext-posix": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "ext-xmlreader": "*",
        "ext-xmlwriter": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "filament/filament": "^4.0",
        "hopla/auth-management": "dev-main",
        "hopla/download-management": "dev-main",
        "hopla/file-or-folder-management": "dev-main",
        "hopla/gateway-management": "dev-main",
        "hopla/history-management": "dev-main",
        "hopla/kes-management": "dev-main",
        "hopla/upload-management": "dev-main",
        "http-interop/http-factory-guzzle": "^1.2",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.40",
        "laravel/octane": "^2.17",
        "laravel/scout": "^11.1",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "^3.30",
        "lomkit/laravel-access-control": "^0.3.2",
        "lomkit/laravel-rest-api": "*",
        "meilisearch/meilisearch-php": "^1.16",
        "php": "^8.4",
        "pragmarx/google2fa-laravel": "^2.3",
        "socialiteproviders/microsoft": "^4.7",
        "socialiteproviders/microsoft-azure": "^5.2",
        "spatie/laravel-permission": "*",
        "spatie/laravel-webhook-server": "^3.10",
        "stancl/tenancy": "^3.9",
        "stechstudio/laravel-zipstream": "^5.7",
        "tymon/jwt-auth": "*"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.4",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.25",
        "laravel/sail": "^1.41",
        "laravel/telescope": "^5.14",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3",
        "xefi/faker-php": "*",
        "xefi/faker-php-laravel": "*",
        "xefi/faker-php-locales-fr-fr": "*",
        "xefi/phpstan-xefi-rules": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --write-mixin",
            "@php artisan ide-helper:eloquent"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "12.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "./packages/auth-management"
        },
        {
            "type": "path",
            "url": "./packages/file-or-folder-management"
        },
        {
            "type": "path",
            "url": "./packages/download-management"
        },
        {
            "type": "path",
            "url": "./packages/upload-management",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "./packages/history-management"
        },
        {
            "type": "path",
            "url": "./packages/kes-management"
        },
        {
            "type": "path",
            "url": "./packages/gateway-management"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
